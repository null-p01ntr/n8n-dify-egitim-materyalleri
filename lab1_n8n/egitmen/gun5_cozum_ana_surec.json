    {
      "id": "6ccca1f9-61e1-42fb-8e88-731a81bac095",
      "name": "Çıktı biçimi",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        720,
        540
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"kategori\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Yeni başvuru\",\n        \"Eksik evrak\",\n        \"Durum sorgusu\",\n        \"Şikâyet\"\n      ],\n      \"description\": \"E-postanın kategorisi. Yalnızca bu dört değerden biri.\"\n    },\n    \"ozet\": {\n      \"type\": \"string\",\n      \"description\": \"En fazla 12 kelimelik kısa Türkçe özet, kişi adı yok. Örnek: \\\"Konut finansmanı başvurusu; tapu fotokopisi eksik.\\\"\"\n    },\n    \"eksik_belge\": {\n      \"type\": \"string\",\n      \"description\": \"Eksik olan belgenin kısa adı (örn. \\\"Tapu fotokopisi\\\"). Eksik belge yoksa boş metin.\"\n    },\n    \"yanit\": {\n      \"type\": \"string\",\n      \"description\": \"Müşteriye gönderilecek Türkçe yanıt taslağı; \\\"Sayın ...\\\" ile başlar, \\\"Finansman Başvuru Birimi\\\" ile biter.\"\n    }\n  },\n  \"required\": [\n    \"kategori\",\n    \"ozet\",\n    \"eksik_belge\",\n    \"yanit\"\n  ],\n  \"additionalProperties\": false\n}",
        "autoFix": true
      }
    },
